---
import { ClientRouter } from 'astro:transitions'
import '@/styles/global.css'
import { User } from '@/lib/var'
import Header from '@/components/Header.astro'
import Footer from '@/components/Footer.astro'
interface Props {
    page: string
}
const { page } = Astro.props
---

<html>
    <head>
        <!-- goole fonts -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@100..900&display=swap" rel="stylesheet" />

        <title>{User.name}</title>
        <meta name="description" content={User.desc}>
        <meta name="keywords" content={User.keywords}>
        <link rel="shortcut icon" href="favicon.svg" type="image/x-icon">

        <meta name="og:title" content={User.name} property="og:title">
        <meta name="og:description" content={User.desc} >
        <meta name="og:image" content='tb.png' >
        <meta name="og:url" content={User.url} >
        <meta name="og:type" content="website" >
        <meta name="og:site_name" content={User.name} >

        <meta name="twitter:card" content="summary_large_image">
        <meta name="twitter:title" content={User.name}>
        <meta name="twitter:description" content={User.desc}>
        <meta name="twitter:image" content='tb.png'>


        <meta http-equiv="Content-Type" content="text/html;charset=UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    </head>
    <body class="px-8 text-gray-800 outfit bg-gray-200 overflow-hidden relative">
        <Header {page} />
        <main class="w-full f-header flex items-center justify-center">
            <slot />
        </main>
        <Footer />
    </body>
</html>

<style>
    body {
        width: 100vw;
        height: 100dvh;
    }
    
    *{
        box-sizing: border-box;
    }

    .f-header {
        height: calc(100dvh - 64px);
    }
</style>
