---
import { User, Links } from '@/lib/var'

const { page } = Astro.props
---

<header class="flex items-center justify-between w-full h-16">
    <h2 class="text-3xl font-bold">{User.name}</h2>
    <ul class="flex items-center gap-2 font-semibold">
        {
            Links.map((link) => {
                const IsActive = link.name === page ? 'active' : ''
                return (
                    <li class={IsActive}>
                        <a href={link.url}>{link.name}</a>
                    </li>
                )
            })
        }
    </ul>
    <a href="https://github.com/dai-rewahandi/dai-new-astro" class="shadow shadow-gray-300 flex items-center justify-center w-14 h-8 rounded-md bg-gray-50 text-gray-700 cursor-pointer" target="_blank">Get</a>
</header>

<style>
    .active {
        position: relative;
    }
    .active::before {
        content: '';
        position: absolute;
        display: block;
        bottom: -3px;
        height: 4px;
        border-radius: 6px;
        background-color: var(--color-gray-700);
        width: 100%;
    }
</style>
